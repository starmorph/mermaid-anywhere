{
  "manifest_version": 3,
  "name": "Mermaid Anywhere — Diagram Renderer",
  "version": "0.1.0",
  "description": "Render Mermaid diagrams on any web page. Works on ChatGPT, Confluence, Stack Overflow, and more.",
  "permissions": ["activeTab", "offscreen"],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
